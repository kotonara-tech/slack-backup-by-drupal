<?php

/**
 * @file
 * Slack Portal module.
 *
 * 実装は TDD（Red→Green→Refactor）で docs/plan のマイルストーン順に追加する。
 * 取得(ingest)は src/Service・src/Drush・src/Plugin/QueueWorker、
 * 取込/公開(portal)は migrations/・config/install/・src/Plugin/migrate に置く。
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\file\FileInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_file_download().
 *
 * Gates canonical-archive attachments: a private:// file under slack_archive
 * is downloadable anonymously only if at least one referencing
 * slack_message node is viewable by the current user (published nodes are
 * viewable by anonymous; unpublished ones are not). Returns -1 to deny, a
 * headers array to allow, or NULL for files this module does not own.
 */
function slack_portal_file_download(string $uri): array|int|null {
  if (!str_contains($uri, 'slack_archive/')) {
    return NULL;
  }

  $files = \Drupal::entityTypeManager()
    ->getStorage('file')
    ->loadByProperties(['uri' => $uri]);
  $file = reset($files);
  if (!$file instanceof FileInterface) {
    return NULL;
  }

  $nids = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'slack_message')
    ->condition('field_attachments.target_id', $file->id())
    ->execute();

  if (!$nids) {
    return -1;
  }

  $nodes = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->loadMultiple($nids);
  foreach ($nodes as $node) {
    if ($node->access('view')) {
      return [
        'Content-Type' => $file->getMimeType(),
        'Content-Length' => $file->getSize(),
      ];
    }
  }

  return -1;
}

/**
 * Implements hook_ENTITY_TYPE_access() for taxonomy_term.
 *
 * Hides private channel names: anonymous (and any non-admin) may not view a
 * slack_channels term whose channel type is not public_channel. This protects
 * private/im/mpim channel names in both the JSON:API term collection and in
 * relationship includes. slack_users terms are unaffected (ADR-0013).
 */
function slack_portal_taxonomy_term_access(
  EntityInterface $entity,
  string $operation,
  AccountInterface $account,
): AccessResult {
  if (
    $operation !== 'view'
    || !$entity instanceof TermInterface
    || $entity->bundle() !== 'slack_channels'
  ) {
    return AccessResult::neutral();
  }

  $type = $entity->hasField('field_channel_type')
    ? $entity->get('field_channel_type')->value
    : NULL;

  if (
    $type === 'public_channel'
    || $account->hasPermission('administer slack_portal')
  ) {
    return AccessResult::neutral()
      ->addCacheContexts(['user.permissions'])
      ->addCacheableDependency($entity);
  }

  return AccessResult::forbidden(
    'Private Slack channel name is not anonymously viewable.',
  )
    ->addCacheContexts(['user.permissions'])
    ->addCacheableDependency($entity);
}
