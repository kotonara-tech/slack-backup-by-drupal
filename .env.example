# slack-backup-by-drupal — 環境変数サンプル
# このファイルをコピーして `.env` を作る: cp .env.example .env
# !!! 実トークンを含む .env は絶対にコミットしない（.gitignore 済 / detect-secrets で検出） !!!

# --- Slack 取得（xoxp- user token を推奨。実運用は Drupal Key モジュールで秘匿） ---
SLACK_USER_TOKEN=xoxp-REPLACE-ME            # pragma: allowlist secret
SLACK_EXPORT_SINCE_DAYS=90
SLACK_RATE_LIMIT_MAX_RETRIES=10

# --- Drupal（DDEV） ---
DRUPAL_BASE_URL=https://slack-backup-by-drupal.ddev.site

# --- Frontend（Next.js） ---
NEXT_PUBLIC_DRUPAL_BASE_URL=https://slack-backup-by-drupal.ddev.site
FRONTEND_HOST_PORT=3000

# --- CORS（Drupal が許可する frontend origin） ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
