<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="slack_portal">
  <description>Drupal / DrupalPractice coding standards for the slack_portal module.</description>

  <file>web/modules/custom/slack_portal</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <exclude-pattern>*/tests/fixtures/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
