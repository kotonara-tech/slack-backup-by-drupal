{
    "name": "kotonara-tech/slack-backup-by-drupal",
    "description": "無料 Slack workspace の直近90日を取得・恒久バックアップし、ヘッドレス Drupal ポータルで閲覧・全文検索する。",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/kotonara-tech/slack-backup-by-drupal",
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "php": ">=8.3",
        "composer/installers": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drush/drush": "^13",
        "drupal/jsonapi_extras": "^3",
        "drupal/jsonapi_search_api": "^1",
        "drupal/search_api": "^1",
        "drupal/facets": "^3",
        "drupal/migrate_plus": "^6",
        "drupal/migrate_tools": "^6",
        "drupal/decoupled_router": "^2",
        "drupal/key": "^1",
        "jolicode/slack-php-api": "^4.8",
        "caseyamcl/guzzle_retry_middleware": "^2.9",
        "symfony/http-client": "^6.4 || ^7",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "drupal/core-dev": "^11",
        "mglaman/phpstan-drupal": "^1.2",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "drupal/coder": "^8.3",
        "weitzman/drupal-test-traits": "^2.2"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": ["homepage", "support"]
        }
    }
}
